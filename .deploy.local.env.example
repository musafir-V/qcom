# Copy to .deploy.local.env and fill in (never commit .deploy.local.env).
# Root account access keys — no browser / aws login required.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
QCOM_ASG_NAME=qcom-asg

# Vonage WhatsApp OTP
# base64-encode your PEM: base64 -i vonage.key | tr -d '\n'
VONAGE_APP_ID=
VONAGE_PRIVATE_KEY=
VONAGE_WHATSAPP_FROM=
